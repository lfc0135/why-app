# Default model is Anthropic Claude via the native Messages API.
# Leave the key blank to stay on the dictionary (no model calls).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Fast Claude model. Haiku or Sonnet only. Opus and larger models are refused.
LLM_MODEL=claude-haiku-5-5
# Lifetime ceiling for Claude calls. Cannot be set above 20.
CLAUDE_BUDGET_USD=20
# Smoke-script cap for one local run. Default $2.
CLAUDE_RUN_CAP_USD=2
# CLAUDE_LEDGER_PATH=data/claude-ledger.json
# CLAUDE_CACHE_DIR=data/script-cache

# OpenAI-compatible alternative. Used only when LLM_PROVIDER=openai.
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Optional spoken audio. If unset, the browser Web Speech API speaks.
# TTS_PROVIDER: openai | elevenlabs | browser
TTS_PROVIDER=
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=nova

# ElevenLabs example:
# TTS_PROVIDER=elevenlabs
# TTS_API_KEY=
# TTS_BASE_URL=https://api.elevenlabs.io
# TTS_MODEL=eleven_multilingual_v2
# TTS_VOICE=
