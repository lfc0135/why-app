# OpenAI-compatible chat completions. Leave the key blank to use the checked shelf only.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional spoken audio. If unset, the browser Web Speech API speaks.
# TTS_PROVIDER: openai | elevenlabs | browser
TTS_PROVIDER=
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=nova

# ElevenLabs example:
# TTS_PROVIDER=elevenlabs
# TTS_API_KEY=
# TTS_BASE_URL=https://api.elevenlabs.io
# TTS_MODEL=eleven_multilingual_v2
# TTS_VOICE=
